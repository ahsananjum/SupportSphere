# Public application origin (set for each environment)
NEXT_PUBLIC_APP_URL=

# Supabase public client configuration (required when Supabase is integrated)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential (never use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider credentials; configure each integration only in its active phase
REDIS_REST_URL=
REDIS_REST_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_SUPPORT=
AI_MODEL_TRIAGE=
AI_MODEL_QUALITY=
JOB_PROVIDER_TOKEN=
JOB_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public Stripe test-mode key (future billing phase)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
